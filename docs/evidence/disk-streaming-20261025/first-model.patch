+// First complete disk-open model; raw target 0x44DBF0, not an admission.
+HRESULT CWaveFile::Open(const char *filename, ThBgmFormat *format, DWORD flags)
+{
+    m_dwFlags = flags;
+    m_bIsReadingFromMemory = FALSE;
+    if (flags == 1)
+    {
+        if (filename == NULL)
+            return E_INVALIDARG;
+        m_hWaveFile = CreateFileA(filename, GENERIC_READ, FILE_SHARE_READ,
+            NULL, OPEN_EXISTING,
+            FILE_ATTRIBUTE_NORMAL | FILE_FLAG_SEQUENTIAL_SCAN, NULL);
+        if (m_hWaveFile == INVALID_HANDLE_VALUE)
+            return E_FAIL;
+        m_pzwf = format;
+        ResetFile(false);
+        m_dwSize = m_ck.cksize;
+    }
+    return S_OK;
+}
