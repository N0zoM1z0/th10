+// Natural member; target's ESI owner/ECX color is private LTCG lowering.
+void TextRenderBufferView::FillColor(unsigned int color)
+{
+    unsigned short value = static_cast<unsigned short>(
+        (((color >> 20 & 15) << 4 | (color >> 12 & 15)) << 4) |
+        (color >> 4 & 15));
+    unsigned short *pixel = static_cast<unsigned short *>(pixels);
+    for (int i = 0; i < static_cast<int>(imageSize); i += 2, ++pixel)
+        *pixel = value;
+}
+struct TextArgb1555PixelView
+{
+    union
+    {
+        unsigned short value;
+        struct
+        {
+            unsigned short rgb : 15;
+            unsigned short alpha : 1;
+        };
+    };
+};
+bool TextRenderBufferView::InvertAlpha(int processedRows)
+{
+    int byteCount = pitch * processedRows;
+    unsigned char *bytes = static_cast<unsigned char *>(pixels);
+    switch (format)
+    {
+    case 0x15:
+        for (int i = 3; i < byteCount; i += 4)
+            bytes[i] = ~bytes[i];
+        break;
+    case 0x19:
+        {
+            TextArgb1555PixelView *pixel = reinterpret_cast<TextArgb1555PixelView *>(bytes);
+            for (int i = 0; i < byteCount; i += 2, ++pixel)
+            {
+                unsigned short rgb = pixel->rgb;
+                pixel->value = ~pixel->value;
+                pixel->rgb = rgb;
+                if (pixel->alpha == 0)
+                    pixel->rgb = 0;
+            }
+        }
+        break;
+    case 0x1a:
+        for (int i = 1; i < byteCount; i += 2)
+            bytes[i] ^= 0xf0;
+        break;
+    default:
+        return false;
+    }
+    return true;
+}
