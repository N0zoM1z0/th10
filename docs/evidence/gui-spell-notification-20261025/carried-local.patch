+#include "GuiScore.hpp"
+extern StageScriptView *g_StagePrimary;
@@ -2857,0 +2861,38 @@
+
+// Full target 0x409C00, called by the maintained END_SPELL dispatcher arm.
+void EnemyEndSpell(EnemyGameStateView *state)
+{
+    if ((state->flags378C & 1) == 0) return;
+    g_StagePrimary->flags |= 1;
+    EnemyMarkPendingInterrupt(&state->panelVmIds[0].value);
+    EnemyMarkPendingInterrupt(&state->panelVmIds[1].value);
+    EnemyMarkPendingInterrupt(&state->panelVmIds[2].value);
+    unsigned int flags = state->flags378C;
+    AnmRenderManagerView *manager = g_AnmRenderManagerView;
+    state->flags378C = flags & ~1u;
+    manager->MarkVmForDeletion(AnmVmIdView(state->managedVmId));
+    state->managedVmId = 0;
+    if ((state->flags378C & 2) != 0) {
+        g_GuiScore.Add(state->currentSpellBonus);
+        GuiNotifySpell(g_GuiView, 0, state->currentSpellBonus);
+        if (*reinterpret_cast<int *>(g_EnemySpellPlaybackState + 0x10) != 1) {
+            unsigned char *statistics = g_EnemySpellStatistics;
+            unsigned char *record = statistics +
+                (g_EnemyChapterState.statisticsGroupA * 3 +
+                 g_EnemyChapterState.statisticsGroupB) * 0x437c +
+                state->spellId * 0x90 + 0x5a4;
+            int count = *reinterpret_cast<int *>(record + 0x80);
+            if (count < 99999) *reinterpret_cast<int *>(record + 0x80) = count + 1;
+            record = statistics + state->spellId * 0x90 + 0x19a8c;
+            count = *reinterpret_cast<int *>(record + 0x80);
+            if (count < 99999) *reinterpret_cast<int *>(record + 0x80) = count + 1;
+        }
+        reinterpret_cast<EnemySoundQueueView *>(g_MainSoundOwner)->QueueSoundSample(0x2d, 0);
+    } else {
+        GuiView *gui = g_GuiView;
+        AnmVmIdView *id = &gui->specialVmId9E14;
+        manager->MarkVmForDeletion(*id);
+        id->value = 0;
+        *id = gui->frontAnm->CreateVmVariant0(0x48, 15);
+    }
+}
