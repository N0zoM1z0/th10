@@ -2121,0 +2122,65 @@
+
+// Full target 0x4172E0 notification, including every event arm.
+void GuiNotifySpell(GuiView *gui, int event, int value)
+{
+    switch (event) {
+    case 0: {
+        g_AnmRenderManagerView->MarkVmForDeletion(gui->specialVmId9E14);
+        gui->specialVmId9E14.value = 0;
+        gui->specialVmId9E14 = gui->frontAnm->CreateVmVariant0(0x47, 15);
+        int remaining = value;
+        int visible = 0;
+        int divisor = 10000000;
+        AnmRenderManagerView *manager = g_AnmRenderManagerView;
+        for (int i = 0; i < 8; ++i) {
+            AnmVmIdView *id = &gui->valueVmIds[i];
+            manager->MarkVmForDeletion(*id);
+            id->value = 0;
+            AnmLoadedView *front = gui->frontAnm;
+            AnmVmView *vm = manager->AllocateVm();
+            vm->renderLayer = 15;
+            vm->flags35C |= 0x40000000u;
+            front->InitializeVm(vm, i + 0x27);
+            manager = g_AnmRenderManagerView;
+            AnmVmIdView created = manager->AddVmVariant0(vm);
+            int digit = remaining / divisor;
+            int remainder = remaining % divisor;
+            *id = created;
+            if (digit != 0) visible = 1;
+            vm = manager->FindVm(*id);
+            if (vm != 0) vm->anmFile->SetSprite(vm, digit + 8);
+            if (visible == 0) id->ClearFlag2();
+            else id->SetFlag2();
+            divisor /= 10;
+            remaining = remainder;
+        }
+        return;
+    }
+    case 1:
+        g_AnmRenderManagerView->MarkVmForDeletion(gui->specialVmId9E14);
+        gui->specialVmId9E14.value = 0;
+        gui->specialVmId9E14 = gui->frontAnm->CreateVmVariant0(0x48, 15);
+        return;
+    case 2:
+        g_AnmRenderManagerView->MarkVmForDeletion(gui->specialVmId9E18);
+        gui->specialVmId9E18.value = 0;
+        gui->specialVmId9E18 = gui->frontAnm->CreateVmVariant0(0x49, 15);
+        return;
+    case 3:
+        g_AnmRenderManagerView->MarkVmForDeletion(gui->specialVmId9E18);
+        gui->specialVmId9E18.value = 0;
+        gui->specialVmId9E18 = gui->frontAnm->CreateVmVariant0(0x4a, 15);
+        return;
+    case 4:
+        g_AnmRenderManagerView->MarkVmForDeletion(gui->specialVmId9E18);
+        gui->specialVmId9E18.value = 0;
+        gui->specialVmId9E18 = gui->frontAnm->CreateVmVariant0(0x4b, 15);
+        return;
+    case 5: return;
+    case 6:
+        g_AnmRenderManagerView->MarkVmForDeletion(gui->specialVmId9E14);
+        gui->specialVmId9E14.value = 0;
+        gui->specialVmId9E14 = gui->frontAnm->CreateVmVariant0(0x4c, 15);
+        return;
+    }
+}
